[Desktop Entry]
Type=Application
Name=cnano
GenericName=Text Editor
Comment=An aesthetic code editor for C, C++, Assembly and shell
Exec=@BINDIR@/cnano %F
Icon=cnano
Terminal=false
Categories=Development;TextEditor;IDE;
MimeType=text/plain;text/x-csrc;text/x-chdr;text/x-c++src;text/x-c++hdr;text/x-asm;application/x-shellscript;text/x-makefile;text/markdown;text/x-python;text/rust;
StartupWMClass=cnano
Keywords=editor;code;c;cpp;assembly;git;
